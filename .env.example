# ---------------------------------------------------------------------------
# OpsDesk configuration. Copy to .env for docker compose; in the cloud put
# these in your secrets manager / task definition environment.
# ---------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------
OPSDESK_DEBUG=0                       # 1 only for local development (relaxes secret checks, enables API docs)
PUBLIC_BASE_URL=http://localhost:8080
SECURE_SSL_REDIRECT=0                 # 1 in production behind HTTPS
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=                 # comma separated; empty = same-origin only (the bundled nginx proxies /api)

# --- ngrok tunnel (optional) -------------------------------------------------
# Start with: docker compose --profile tunnel up -d ngrok ; the public URL is shown at http://localhost:4040
NGROK_AUTHTOKEN=                      # from dashboard.ngrok.com

# --- Authentication ----------------------------------------------------------
# Signs access/refresh tokens. 50+ random characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
JWT_SECRET_KEY=change-me-to-50-random-characters
JWT_ACCESS_MINUTES=15
JWT_REFRESH_HOURS=24

# --- Signed tenant context ---------------------------------------------------
# HMAC key for the database's row-level-security tenant verifier. Required in production.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# The key must also exist in opsdesk_secure.signing_keys (see `opsdesk keys add`); migrations seed the key from these values.
OPSDESK_SIGNING_KEY_ID=k1
OPSDESK_SIGNING_KEY_SECRET=

# --- Database --------------------------------------------------------------
# App role (row-level security enforced)
DATABASE_URL=postgres://opsdesk_app:CHANGE_ME_app@db:5432/opsdesk
# Schema owner, used only by the `migrate` job
MIGRATION_DATABASE_URL=postgres://opsdesk_owner:CHANGE_ME_owner@db:5432/opsdesk
DB_APP_ROLE=opsdesk_app
DB_REQUIRE_SSL=0                      # 1 for managed cloud databases
FASTAPI_DB_POOL_MIN=2                 # API connection pool; never put a transaction-mode pooler in front (session settings carry the tenant)
FASTAPI_DB_POOL_MAX=10

# --- Redis / jobs -----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_CONCURRENCY=4

# --- Secrets encryption (channel credentials) ------------------------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate keys to rotate: newest first.
FIELD_ENCRYPTION_KEYS=

# --- Email ------------------------------------------------------------------
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=OpsDesk <support@example.com>

# --- Attachments --------------------------------------------------------------
STORAGE_BACKEND=local                 # s3 in the cloud
MEDIA_ROOT=/app/media
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=                      # for MinIO / R2 / GCS interoperability
ATTACHMENT_MAX_MB=20
ATTACHMENT_SCANNER=none               # clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- AI engine --------------------------------------------------------------
AI_EMBEDDING_PROVIDER=hashing         # hashing (local, offline) | openai (any OpenAI-compatible endpoint)
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_API_KEY=
AI_LLM_PROVIDER=none                  # none | anthropic | openai
AI_LLM_MODEL=claude-haiku-5-5
AI_LLM_BASE_URL=
AI_LLM_API_KEY=
AI_REDACT_PII=1
# AI_DUPLICATE_THRESHOLD / AI_SIMILAR_MIN_SCORE default per embedder; override after measuring.

# --- Extra channel adapters (plug-ins) --------------------------------------
# EXTRA_CHANNEL_ADAPTERS=teams=mycompany.channels.TeamsAdapter,sms=mycompany.channels.TwilioSmsAdapter
